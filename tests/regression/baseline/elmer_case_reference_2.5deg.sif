Material 6
  Name = "rotor housing"
  Relative Permeability = 1
  Relative Permittivity = 1
  Electric Conductivity = 0
End

Equation 1
  Name = "magnetostatics"
  Active Solvers(2) = 1 2
End

Solver 1
  Equation = MGDynamics
  Variable = AV
  Procedure = "MagnetoDynamics" "WhitneyAVSolver"
  Fix Input Current Density = Logical False
  Edge Basis = Logical True
  Apply Conforming BCs = Logical True
  Optimize Bandwidth = False
  Newton-Raphson Iteration = Logical True
  Nonlinear System Max Iterations = 40
  Nonlinear System Convergence Tolerance = 1e-05
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStabl
  BiCGStabl Polynomial Degree = 4
  Linear System Preconditioning = ILU0
  Linear System Max Iterations = 3000
  Linear System Convergence Tolerance = 1e-08
  Linear System Residual Output = 100
  Linear System Abort Not Converged = True
  Steady State Convergence Tolerance = 1e-6
End

Solver 2
  Equation = MGDynamicsCalc
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Potential Variable = String "AV"
  Calculate Magnetic Flux Density = Logical True
  Calculate Magnetic Vector Potential = Logical True
  Calculate Nodal Forces = Logical True
  Discontinuous Bodies = Logical True
  Linear System Symmetric = True
  Linear System Solver = Iterative
  Linear System Iterative Method = CG
  Linear System Preconditioning = None
  Linear System Max Iterations = 5000
  Linear System Convergence Tolerance = 1e-8
  Linear System Residual Output = 0
  Steady State Convergence Tolerance = 0
End

Solver 3
  Exec Solver = After All
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Save Component Results = Logical True
End

Solver 4
  Exec Solver = After All
  Equation = ResultOutput
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = fields
  Vtu Format = Logical True
  Ascii Output = Logical True
  Save Geometry Ids = Logical True
  Save Bulk Only = Logical True
  Discontinuous Bodies = Logical True
End

Component 1
  Name = "rotor"
  Master Bodies(9) = 2 3 4 5 6 7 8 9 10
  Calculate Magnetic Torque = Logical True
  Torque Axis(3) = Real 0 0 1
  Torque Origin(3) = Real 0 0 0
End

Boundary Condition 1
  Name = "outer_rotor"
  Target Boundaries(1) = 4
  AV {e} = Real 0
End

Boundary Condition 2
  Name = "outer_stator"
  Target Boundaries(1) = 8
  AV {e} = Real 0
End

Boundary Condition 3
  Name = "periodic_b_rotor"
  Target Boundaries(1) = 3
End

Boundary Condition 4
  Name = "periodic_a_rotor"
  Target Boundaries(1) = 2
  Conforming BC = Integer 3
  Radial Projector = Logical True
  Level Projector = Logical True
End

Boundary Condition 5
  Name = "periodic_b_stator"
  Target Boundaries(1) = 7
End

Boundary Condition 6
  Name = "periodic_a_stator"
  Target Boundaries(1) = 6
  Conforming BC = Integer 5
  Radial Projector = Logical True
  Level Projector = Logical True
End
