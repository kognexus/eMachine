# Environments and tools: rebuilt by `pixi install` and `pixi run install-elmer`
.pixi/
.venv*/
.elmer/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.DS_Store
.claude/
.vscode/
.idea/

# Personal files kept out of the repository
local/

# Results: regenerated by the commands in docs/usage.md
runs/
*.log
examples/validation/*/raw/
examples/validation/*/variants/*/raw/

# Meshes and solver output written next to inputs
*.msh
*.mesh
*.ep
*.result
